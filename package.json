{
    "name": "Teding",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --webpack --port 4000",
        "build": "next build --webpack",
        "build:web": "next build --webpack",
        "build:app": "node scripts/build-app.js",
        "prebuild:app": "bash scripts/check-dynamic-routes.sh",
        "sync:app": "pnpm build:app && npx cap sync",
        "open:android": "npx cap open android",
        "run:android": "pnpm sync:app && npx cap run android",
        "check:dynamic-routes": "bash scripts/check-dynamic-routes.sh",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.82.0",
        "@base-ui/react": "^1.3.0",
        "@capacitor/android": "^8.3.1",
        "@capacitor/app": "^8.1.0",
        "@capacitor/core": "^8.3.1",
        "@capacitor/local-notifications": "^8.0.2",
        "@capacitor/network": "^8.0.1",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/splash-screen": "^8.0.1",
        "@capacitor/status-bar": "^8.0.2",
        "@google/generative-ai": "^0.24.1",
        "@next/third-parties": "^16.2.4",
        "@serwist/next": "^9.5.7",
        "@supabase/ssr": "^0.10.0",
        "@supabase/supabase-js": "^2.101.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cross-env": "^10.1.0",
        "date-fns": "^4.1.0",
        "lucide-react": "^1.7.0",
        "next": "16.2.2",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "serwist": "^9.5.7",
        "shadcn": "^4.1.2",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^8.3.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/youtube": "^0.2.0",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.2",
        "sharp": "0.33.0",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "pnpm": {
        "onlyBuiltDependencies": ["sharp"],
        "overrides": {
            "sharp": "0.33.0"
        }
    }
